}

# -------------------------------
# Part 3: Endpoints
# -------------------------------

# GET /product
@app.route('/product', methods=['GET'])
def get_all_products():
    """
    Get All Products
    ---
    responses:
      200:
        description: Returns all products
    """
    return jsonify(Products)


# POST /product/mod
@app.route('/product/mod', methods=['POST'])
def update_product():
    """
    Add or Modify Product
    ---
    parameters:
      - in: body
        name: product
        required: true
        schema:
          type: object
          properties:
            ID:
              type: integer
            Name:
              type: string
            Price:
              type: number
            Type:
              type: string
    responses:
      200:
        description: Product added or modified
    """
    product = request.get_json()

    # Check if product exists by ID
    for i, existing_product in enumerate(Products):
        if existing_product['ID'] == product['ID']:
            Products[i] = product
            return "Modified Product"

    # If not found, add new product
    Products.append(product)
    return "Added New Product"


